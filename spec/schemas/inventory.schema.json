{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NickChaps/AIR-Framework/spec/schemas/inventory.schema.json",
  "title": "AIR Framework inventory snapshot",
  "type": "object",
  "required": ["schema_version", "inventory_id", "snapshot_id", "captured_at", "objects", "relations", "evidence"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "inventory_id": {"type": "string", "minLength": 1},
    "snapshot_id": {"type": "string", "minLength": 1},
    "captured_at": {"type": "string", "format": "date-time"},
    "objects": {
      "type": "array",
      "items": {"$ref": "#/$defs/object"}
    },
    "relations": {
      "type": "array",
      "items": {"$ref": "#/$defs/relation"}
    },
    "evidence": {
      "type": "array",
      "items": {"$ref": "#/$defs/evidence"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "object_type": {
      "enum": ["ai_system", "ai_platform", "configured_ai_application", "agent_skill", "connector", "model", "ai_use", "organization", "provider", "service", "contract", "clause_library", "generic"]
    },
    "fact": {
      "type": "object",
      "required": ["state"],
      "properties": {
        "state": {"enum": ["known", "unknown", "conflicted", "not_applicable"]},
        "value": {},
        "evidence": {"type": "array", "items": {"type": "string"}},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "extractor": {"type": "object"},
        "note": {"type": "string"}
      },
      "additionalProperties": true
    },
    "object": {
      "type": "object",
      "required": ["id", "type", "name", "facts"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"$ref": "#/$defs/object_type"},
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "external_ids": {"type": "object"},
        "facts": {"type": "object", "additionalProperties": {"$ref": "#/$defs/fact"}}
      },
      "additionalProperties": true
    },
    "relation": {
      "type": "object",
      "required": ["id", "source", "type", "target"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "type": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "evidence": {
      "type": "object",
      "required": ["id", "kind", "source", "summary"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "locator": {"type": "string"},
        "captured_at": {"type": "string", "format": "date-time"},
        "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": true
    }
  }
}
