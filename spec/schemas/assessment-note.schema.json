{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NickChaps/AIR-Framework/spec/schemas/assessment-note.schema.json",
  "title": "AIR Framework readable assessment note",
  "type": "object",
  "required": [
    "schema_version",
    "note_id",
    "created_at",
    "language",
    "target",
    "inputs",
    "renderer",
    "summary",
    "scope",
    "statements",
    "review_status"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "note_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "language": {"type": "string", "minLength": 2},
    "target": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"$ref": "#/$defs/object_type"},
        "name": {"type": "string"}
      },
      "additionalProperties": true
    },
    "inputs": {
      "type": "object",
      "required": ["inventory", "extraction_ids", "assessment_ids"],
      "properties": {
        "inventory": {
          "type": "object",
          "required": ["inventory_id", "snapshot_id"],
          "properties": {
            "inventory_id": {"type": "string", "minLength": 1},
            "snapshot_id": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        "extraction_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "assessment_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "route_result_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    },
    "renderer": {
      "type": "object",
      "required": ["kind", "id", "version"],
      "properties": {
        "kind": {"enum": ["template", "llm", "hybrid", "human"]},
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "model": {"type": "object"},
        "run_id": {"type": "string"}
      },
      "additionalProperties": false
    },
    "summary": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "statements": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/statement"}
    },
    "cautions": {"type": "array", "items": {"type": "string"}},
    "review_status": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {
          "enum": [
            "not_selected",
            "selected",
            "confirmed",
            "corrected",
            "inconclusive"
          ]
        },
        "review_id": {"type": "string", "minLength": 1},
        "selection_reason": {"type": "string"}
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {"status": {"not": {"const": "not_selected"}}},
            "required": ["status"]
          },
          "then": {"required": ["review_id"]}
        }
      ]
    }
  },
  "additionalProperties": false,
  "$defs": {
    "object_type": {
      "enum": [
        "ai_system",
        "ai_platform",
        "configured_ai_application",
        "skill",
        "connector",
        "model",
        "ai_use",
        "organization",
        "provider",
        "service",
        "contract",
        "clause_library",
        "generic"
      ]
    },
    "statement": {
      "type": "object",
      "required": ["statement_id", "kind", "text", "references"],
      "properties": {
        "statement_id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["fact", "finding", "unknown", "route", "review"]},
        "text": {"type": "string", "minLength": 1},
        "references": {
          "type": "object",
          "properties": {
            "fact_ids": {"type": "array", "items": {"type": "string"}},
            "evidence": {"type": "array", "items": {"type": "string"}},
            "assessment_id": {"type": "string"},
            "rule_ids": {"type": "array", "items": {"type": "string"}},
            "anchor_ids": {"type": "array", "items": {"type": "string"}},
            "route_result_id": {"type": "string"},
            "route_ids": {"type": "array", "items": {"type": "string"}},
            "review_id": {"type": "string"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
