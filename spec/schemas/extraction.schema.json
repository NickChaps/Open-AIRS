{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NickChaps/AIR-Framework/spec/schemas/extraction.schema.json",
  "title": "AIR Framework extraction and analysis record",
  "type": "object",
  "required": [
    "schema_version",
    "extraction_id",
    "created_at",
    "target",
    "inventory",
    "pack_inputs",
    "extractor",
    "source_evidence",
    "fact_proposals",
    "analysis"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "extraction_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "target": {
      "type": "object",
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "$ref": "#/$defs/object_type"
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "inventory": {
      "type": "object",
      "required": [
        "inventory_id",
        "snapshot_id"
      ],
      "properties": {
        "inventory_id": {
          "type": "string",
          "minLength": 1
        },
        "snapshot_id": {
          "type": "string",
          "minLength": 1
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "pack_inputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "id",
          "version",
          "content_hash"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "content_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "extractor": {
      "type": "object",
      "required": [
        "kind",
        "skill"
      ],
      "properties": {
        "kind": {
          "enum": [
            "llm",
            "human",
            "hybrid"
          ]
        },
        "skill": {
          "type": "object",
          "required": [
            "id",
            "version"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "model": {
          "type": "object"
        },
        "prompt_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "prompt_template": {
          "type": "object",
          "required": [
            "id",
            "version",
            "content_hash"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "content_hash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "additionalProperties": false
        },
        "run_id": {
          "type": "string"
        },
        "usage": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "source_evidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "fact_proposals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/fact_proposal"
      }
    },
    "analysis": {
      "$ref": "#/$defs/analysis"
    },
    "taxonomy": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Canonical content hash of the exact taxonomy file offered to the extractor."
        }
      },
      "additionalProperties": false
    },
    "proposed_uses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/proposed_use"
      }
    },
    "excluded_mentions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/excluded_mention"
      }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "extractor": {
            "properties": {
              "kind": {
                "enum": [
                  "llm",
                  "hybrid"
                ]
              }
            },
            "required": [
              "kind"
            ]
          }
        },
        "required": [
          "extractor"
        ]
      },
      "then": {
        "properties": {
          "fact_proposals": {
            "items": {
              "required": [
                "confidence"
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "object_type": {
      "enum": [
        "ai_system",
        "ai_platform",
        "configured_ai_application",
        "skill",
        "connector",
        "model",
        "ai_use",
        "organization",
        "provider",
        "service",
        "contract",
        "clause_library",
        "generic"
      ]
    },
    "fact_proposal": {
      "type": "object",
      "required": [
        "fact_id",
        "state",
        "rationale"
      ],
      "properties": {
        "fact_id": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": [
            "known",
            "unknown",
            "conflicted",
            "not_applicable"
          ]
        },
        "value": {},
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "known"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "value"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "known",
                  "conflicted"
                ]
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "evidence"
            ],
            "properties": {
              "evidence": {
                "minItems": 1
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "analysis": {
      "type": "object",
      "required": [
        "summary",
        "scope",
        "observations",
        "unknowns"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "observations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "statement",
              "fact_ids",
              "evidence"
            ],
            "properties": {
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "fact_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": false
          }
        },
        "unknowns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cautions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "proposed_use": {
      "type": "object",
      "required": [
        "purpose_statement",
        "purpose_tags",
        "evidence"
      ],
      "properties": {
        "use_id": {
          "type": "string",
          "minLength": 1
        },
        "purpose_statement": {
          "type": "string",
          "minLength": 1
        },
        "purpose_tags": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "material_tasks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "affected_people": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "decision_influence": {
          "enum": [
            "none",
            "informative",
            "material",
            "determinative"
          ]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "alternative_interpretations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rationale": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "excluded_mention": {
      "type": "object",
      "required": [
        "candidate_use",
        "classification",
        "evidence"
      ],
      "properties": {
        "candidate_use": {
          "type": "string",
          "minLength": 1
        },
        "classification": {
          "enum": [
            "prohibited_by_instructions",
            "guardrail",
            "example_reference",
            "capability_only"
          ]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
