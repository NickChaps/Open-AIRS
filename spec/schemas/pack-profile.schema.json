{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NickChaps/AIR-Framework/spec/schemas/pack-profile.schema.json",
  "title": "AIR Framework pack-selection profile",
  "type": "object",
  "required": ["schema_version", "profile", "packs"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "profile": {
      "type": "object",
      "required": ["id", "version", "name"],
      "properties": {
        "id": {"type": "string"},
        "version": {"type": "string"},
        "name": {"type": "string"},
        "reviewed_at": {"type": "string", "format": "date"}
      }
    },
    "packs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "version", "path"],
        "properties": {
          "id": {"type": "string"},
          "version": {"type": "string"},
          "path": {"type": "string"},
          "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
